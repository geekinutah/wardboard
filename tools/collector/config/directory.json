{
  "_note": "Ward Directory and Map, checked 2026-11-01. Match links and photos by URL shape. Do not use styled-component class names; those change when the site is rebuilt. An unrecognized page is still refused.",
  "layoutVersion": "directory-v2",
  "startUrl": "https://directory.churchofjesuschrist.org/",
  "selectors": {
    "householdList": "a[href*='/households/']",
    "householdLink": "a[href*='/households/']:not([href*='/move'])",
    "householdName": "h1",
    "householdImage": "img[src*='/photos/households/']",
    "memberEntry": "div:has(> div > img[src*='/photos/members/']):has(> div > a[href*='/members/'])",
    "memberName": "a[href*='/members/']",
    "memberPortrait": "img[src*='/photos/members/']",
    "signedOut": "form[action*='signin'], #okta-sign-in"
  },
  "timeouts": { "navigationMs": 30000, "elementMs": 10000 },
  "retries": { "image": 2 }
}
