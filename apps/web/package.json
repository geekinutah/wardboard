{
  "name": "@wardboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test:e2e:playwright": "pnpm run build && ../../scripts/e2e-slot.pl playwright test -c e2e/playwright.config.ts",
    "test:e2e": "playwright install chromium webkit && pnpm run test:e2e:playwright",
    "gui:capture": "pnpm run build && WARDBOARD_GUI_CAPTURE=1 ../../scripts/e2e-slot.pl playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@wardboard/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wardboard/server": "workspace:*",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
